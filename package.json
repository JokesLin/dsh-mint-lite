{
  "name": "dsh-mint-lite",
  "version": "1.1.0",
  "description": "极轻量月光配色主题：冷白偏蓝内容区 + 深海军蓝深色模式 + 圆润字体，强调色不动。",
  "license": "MIT",
  "author": {
    "name": "Joke Lin",
    "url": "https://github.com/JokesLin"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JokesLin/dsh-mint-lite.git"
  },
  "homepage": "https://github.com/JokesLin/dsh-mint-lite#readme",
  "bugs": {
    "url": "https://github.com/JokesLin/dsh-mint-lite/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "theme",
    "cordis",
    "plugin",
    "lightweight",
    "moonlight",
    "navy"
  ],
  "private": false,
  "type": "module",
  "main": "index.js",
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "assets/preview.png"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-theme"
      ]
    }
  }
}
